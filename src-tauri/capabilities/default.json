{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "IFC Academy desktop permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    "fs:default",
    "fs:allow-mkdir",
    "fs:allow-read-file",
    "fs:allow-write-file",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$DOCUMENT/IFC Academy Data"
        },
        {
          "path": "$DOCUMENT/IFC Academy Data/*"
        },
        {
          "path": "$DOCUMENT/IFC Academy Data/**/*"
        }
      ]
    }
  ]
}
